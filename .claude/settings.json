{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh issue close *)",
      "PowerShell(gh issue close *)",
      "Edit(/pom.xml)",
      "Edit(/src/main/resources/db/migration/**)"
    ]
  }
}
